---
# =============================================================================
# Site repository policy for reenable-third-party-repos.yml
#
# Copy to vars/site-repos.yml, fill in your own values, and pass it with:
#   ansible-playbook reenable-third-party-repos.yml -e @vars/site-repos.yml
#
# vars/site-repos.yml is gitignored, because a repository set names your
# internal mirror hosts.
#
# Build the values from a server that is ALREADY on 24.04 and known good:
#   apt-get indextargets --no-release-info --format '$(SITE) $(RELEASE)' | sort -u
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Sources whose codename must NOT be rewritten jammy -> noble.
#
# Regexes matched against the source FILE PATH.
#
# Some vendors pin the release codename into the repository path as part of a
# build identifier, for example:
#
#   deb http://mirror.example.com/apt/fluentbit/jammy-4.0.0 ./
#
# There is no "noble-4.0.0" to move to — that vendor simply publishes one
# build and 24.04 hosts keep using the jammy-named path. Rewriting it points
# the host at a URL that does not exist, and because the entry is a flat repo
# ("./") apt reports it as Ign rather than a hard error, so it fails quietly.
#
# This cannot be detected automatically: "jammy-4.0.0" and "jammy-updates" are
# the same shape, and the first must be left alone while the second must be
# rewritten. List the exceptions explicitly.
# ---------------------------------------------------------------------------
codename_rewrite_exclude:
  - 'fluentbit'
  # - 'some-other-vendor'

# ---------------------------------------------------------------------------
# 2. The repository set an upgraded host must end up with.
#
# Each entry is a substring matched against "SITE SUITE" from
# apt-get indextargets. Keep them short and unambiguous — the mirror path plus
# the suite is enough. A host missing any of these fails the play.
#
# Note the mix that is normal after an upgrade:
#   * the OS mirror moves to noble / noble-updates / noble-security
#   * vendor repos with their own suite (pbiso) keep it
#   * vendor repos with a pinned path keep the old codename (see above)
# ---------------------------------------------------------------------------
expected_repos:
  - 'apt/ubuntu-stable noble'
  - 'apt/ubuntu-stable noble-updates'
  - 'apt/ubuntu-stable noble-security'
  # - 'apt/zabbix-6.0 noble'
  # - 'apt/pbis-open pbiso'
  # - 'apt.releases.hashicorp.com noble'
  # - 'ansible/ubuntu noble'

# ---------------------------------------------------------------------------
# 3. Whether the upgrader-disabled third-party repos come back on.
#
# true  — restore them (they are part of the expected set above)
# false — leave them disabled and only repoint what is already enabled
# ---------------------------------------------------------------------------
reenable_third_party: true

# ---------------------------------------------------------------------------
# 4. The source set deploy-apt-sources.yml writes.
#
# Take these VERBATIM from a reference host that is already correct:
#
#   for f in /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
#     echo "### $f"; cat "$f"
#   done
#
# Only *.list and *.sources are read by apt. Leftovers such as
# *.distUpgrade, *.save and *.curtin.orig are inert and must NOT be listed
# here — they exist as backups, and recreating them would be noise.
#
# Do not guess components. "main" versus "main restricted universe
# multiverse" decides whether half your packages are installable, and it is
# not visible in apt-get update output — copy the real line.
# ---------------------------------------------------------------------------
desired_apt_sources:
  - path: ubuntu24.list
    content: |
      deb http://mirror.example.com/apt/ubuntu-stable noble main
      deb http://mirror.example.com/apt/ubuntu-stable noble-updates main
      deb http://mirror.example.com/apt/ubuntu-stable noble-security main

  - path: fluent-bit.list
    # Pinned to the vendor's jammy build path on purpose — there is no
    # noble-4.0.0. Flat repo, hence the "./" and no components. [trusted=yes]
    # because the vendor publishes it unsigned, which is why apt shows it as
    # Ign: rather than Hit: — that is expected, not a failure.
    content: |
      deb [trusted=yes] http://mirror.example.com/apt/fluentbit/jammy-4.0.0 ./

  - path: hashicorp.list
    content: |
      deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com noble main

  - path: ansible.list
    content: |
      deb [signed-by=/usr/share/keyrings/ansible-archive-keyring.gpg] http://ppa.launchpad.net/ansible/ansible/ubuntu noble main

  # A deb822 entry can carry its signing key inline instead of pointing at a
  # keyring file. Keep the single-space indent on every continuation line and
  # the " ." that marks a blank line inside the folded field — a YAML literal
  # block preserves both exactly.
  # - path: example-ppa.sources
  #   content: |
  #     Types: deb
  #     URIs: https://ppa.launchpadcontent.net/example/ppa/ubuntu/
  #     Suites: noble
  #     Components: main
  #     Signed-By: -----BEGIN PGP PUBLIC KEY BLOCK-----
  #      .
  #      mQINBFOXbTABEADKLcY3MYZyHIiCEu8cQ+0UzxZolTYZf8xZ06/d8xzUW/UBPTLV
  #      =qlCh
  #      -----END PGP PUBLIC KEY BLOCK-----

  - path: pbis-open.sources
    content: |
      Types: deb
      URIs: http://mirror.example.com/apt/pbis-open
      Suites: pbiso
      Components: main

  - path: zabbix.sources
    content: |
      Types: deb
      URIs: http://mirror.example.com/apt/zabbix-6.0
      Suites: noble
      Components: main
